-- case009.json --
{
  "bindings": {},
  "data": null,
  "expr-file": "case009.jsonata"
}
-- case009.JSONATA --
(
 $months := [
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
 ];
 $indexof := λ($array, $value) {
  $reduce($array, λ($acc, $v, $i) {
   $v=$value ? $i : $acc
  })
 };
 $indexof($months, 'May')
)
-- case009_expected.json --
4
-- case010.json --
{
  "bindings": {},
  "data": null,
  "expr-file": "case010.jsonata"
}
-- case010.JSONATA --
(
  $mean := $reduce(?, λ($acc, $v, $i, $arr) {(
    $total := $acc + $v;
    $length := $count($arr);
    $i = $length - 1 ? $total / $length : $total
  )});

  $mean([7,3,8])
)
-- case010_expected.json --
6
